{
  "name": "recepy-app",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "expo start --go --lan",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 src/domain/recipeParser.test.ts src/domain/menuGesture.test.ts src/domain/panelGesture.test.ts src/domain/recipeOpeningGesture.test.ts src/domain/commentsOpeningGesture.test.ts src/domain/commentThreads.test.ts src/domain/keyboardLayout.test.ts src/domain/cookingGuide.test.ts src/domain/recipeReview.test.ts",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.5",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
